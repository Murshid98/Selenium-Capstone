<?xml version="1.0" encoding="UTF-8"?>
<Configuration packages="org.apache.logging.log4j.core">
    <!--
        Log4j2 Configuration File

        This configuration sets up logging for the test automation framework.
        Logs are written to:
        - Console: Real-time test execution logs
        - File: Detailed logs for debugging
    -->

    <Appenders>
        <!-- Console Appender - Displays logs in console -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                pattern="[%d{HH:mm:ss.SSS}] [%-5level] [%c{1}] - %msg%n" />
        </Console>

        <!-- File Appender - Logs to file for detailed review -->
        <File name="FileAppender"
              fileName="./test-results/logs/test_execution.log">
            <PatternLayout
                pattern="[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%-5level] [%c{1}] - %msg%n" />
        </File>

        <!-- Rolling File Appender - Creates new file based on date -->
        <RollingFile name="RollingFile"
                     fileName="./test-results/logs/app.log"
                     filePattern="./test-results/logs/app-%d{yyyy-MM-dd}.%i.log">
            <PatternLayout
                pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%-5level] [%c{1}] - %msg%n" />
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="10MB" />
            </Policies>
            <DefaultRolloverStrategy max="10" />
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Root Logger - Catches all logs -->
        <Root level="info">
            <AppenderRef ref="Console" />
            <AppenderRef ref="FileAppender" />
            <AppenderRef ref="RollingFile" />
        </Root>

        <!-- Selenium Specific Logger -->
        <Logger name="org.openqa.selenium" level="warn">
            <AppenderRef ref="Console" />
            <AppenderRef ref="RollingFile" />
        </Logger>

        <!-- TestNG Logger -->
        <Logger name="org.testng" level="info">
            <AppenderRef ref="Console" />
            <AppenderRef ref="RollingFile" />
        </Logger>

        <!-- Application Logger -->
        <Logger name="com.saucedemo" level="debug">
            <AppenderRef ref="Console" />
            <AppenderRef ref="FileAppender" />
        </Logger>
    </Loggers>
</Configuration>
